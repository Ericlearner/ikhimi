# Copy to apps/web/.env.local and workers/.env (or export in your shell). On Vercel, the same names go in
# Settings → Environment Variables. Every value here belongs to 익히미 only: never reuse another app's keys or bots.
DATABASE_URL=postgres://ikhimi:ikhimi@localhost:5432/ikhimi

# Long random string. Hashes OTP codes and IPs. `openssl rand -hex 32`
AUTH_PEPPER=change-me-to-a-long-random-string

# "Log in with Telegram" (free). Create a NEW bot with @BotFather → /newbot, paste its token and username.
# Local dev: run `pnpm telegram:poll`. Production: set PUBLIC_ORIGIN (https), then Admin → Health → "봇 설정"
# (or `pnpm --filter @ikhimi/web telegram:webhook`).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any long random string (`openssl rand -hex 24`)
TELEGRAM_WEBHOOK_SECRET=

# Phone + code login (optional; hidden in production while SMS_PROVIDER=console).
# How login codes are delivered:
#   console  — dev: prints codes to the server log
#   telegram — Telegram Gateway, for every number
#   twilio   — SMS through Twilio (Korean numbers included)
SMS_PROVIDER=console
# From https://gateway.telegram.org (account → API token)
TELEGRAM_GATEWAY_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Homework generation and grading: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Default model for every task, and the fallback when a task's own model is busy
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# Paid plan (DECISIONS.md AO): put your strongest model on the quality-critical tasks. Unset = GEMINI_MODEL.
# Use the exact model id from AI Studio; a wrong id makes generation fail with "AI rejected".
# GEMINI_MODEL_GENERATE=   # writing homework
# GEMINI_MODEL_PLAN=       # Create mode's plan step: reads the pages, picks counts and words (fast is best)
# GEMINI_MODEL_REVIEW=     # checking/repairing items, solve-back, listening audio match
# GEMINI_MODEL_GRADE=      # grading essays and students' own sentences
# GEMINI_MODEL_FAST=       # small chores
# GEMINI_MODEL_LAB=        # the owner's Lab: put the very strongest model here (unset = GENERATE, then REVIEW).
#                            Never falls back to a weaker model: when it's busy, the Lab says "try again".
# Pronunciation for vocabulary items ("listen and choose the word"); off = those items ask by meaning instead
# GEMINI_MODEL_TTS=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Kore
# Model reasoning: level (Gemini 3 models) | budget (Gemini 2.5) | off
GEMINI_THINKING=off
# Second pass that checks and repairs every generated item (Create mode): 1 on, 0 off
AI_REVIEW=1

# Admin panel (/admin). Owners: comma-separated phone numbers in international form (+821012345678), with full
# access, the only ones who manage staff. Assistants are added inside the panel (Staff) by phone number and role.
OWNER_PHONES=
# AI price list for the cost estimates, USD per million tokens [input, output]; the longest key found in the
# model name wins. Unset = built-in estimates by family (flash-lite, flash, pro).
# AI_PRICES={"gemini-3.8-flash":[0.5,3],"pro":[2,12]}
# Won per dollar, for showing AI cost in won
# USD_KRW=1400
# Local only: canned demo AI when no key is set (ignored in production)
# LLM_FAKE=1

# Methodology retrieval (§8.5): embeds packages/pedagogy content for the Plan/Verify stages.
# Uses the same GEMINI_API_KEY above. Run `pnpm pedagogy:seed` after changing pedagogy content.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# File storage. Leave S3_* empty to store uploads in Postgres (fine for Vercel / small pilots).
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=https://files.ikhimi.kr
S3_REGION=us-east-1
S3_BUCKET=ikhimi
S3_ACCESS_KEY=ikhimi
S3_SECRET_KEY=ikhimi-dev-secret

# The site's own address (links, QR codes, the Telegram webhook). In production: https://<your domain>
PUBLIC_ORIGIN=http://localhost:3000

# ─── Payments (courses, student plans, teacher packages) ───
# No payment gateway is connected yet (a Korean one such as Toss Payments plugs into server/payments/providers.ts).
# Until then: bank transfers in the Telegram bot (below), and the "test" provider to try the purchase flow.
# The test provider is always on in development; in production only with this flag (anyone could "pay" with it!).
# PAYMENT_TEST_ENABLED=1

# ─── Bank transfers (계좌이체) in the Telegram bot ───
# Buyers pick a plan in the bot (/plans, or the website's "텔레그램에서 계좌이체로 결제"), transfer to this account and
# send the transfer confirmation; it goes to the admins' chat with Approve / Reject. Unset PAY_ACCOUNT_NUMBER = off.
# PAY_BANK_NAME=신한은행
# PAY_ACCOUNT_NUMBER=110-123-456789
# PAY_ACCOUNT_HOLDER=홍길동
# Where confirmations go: chat ids, comma-separated (a group with the bot in it, or a person who has started the bot).
# Unset = the owners' own Telegram (OWNER_PHONES who signed in with Telegram). Only the owner or staff with the
# Money permission, whose Telegram is linked to their 익히미 account, can press Approve / Reject.
# PAY_ADMIN_CHAT_ID=
# The Telegram channel the owner posts to from the bot (/post <text>, previewed, then posted with a
# "💳 요금제 구매" button that opens the bot's shop). @name or the -100… id; the bot must be the channel's admin.
# TELEGRAM_CHANNEL_ID=@channel_name

# ─── Support (runs on the login bot by default) ───
# Non-login messages to the bot are copied to this chat; reply there to answer.
# Send /id to the bot (or in a group with the bot) to get the number.
# SUPPORT_ADMIN_CHAT_ID=
# Optional: a separate support bot instead of the login bot
# SUPPORT_BOT_TOKEN=
# SUPPORT_BOT_USERNAME=

# ─── Daily job and alerts ───
# Vercel calls /api/cron/daily every evening at 18:00 Korean time (apps/web/vercel.json): due-tomorrow reminders,
# erasing accounts deleted 30+ days ago. Set any long random string; Vercel sends it with the call so nobody else can
# run the job.
# CRON_SECRET=
# Where "something broke" alerts go. Unset = the owners' own Telegram (OWNER_PHONES who signed in with Telegram), else
# SUPPORT_ADMIN_CHAT_ID.
# ALERT_CHAT_ID=

# ─── App-store review login ───
# Google Play / App Store reviewers can't receive a code. This made-up number always accepts this 6-digit code,
# nothing is sent to it, and it opens a ready account (name, teacher and student sides, VIP). Unset = off.
# REVIEW_LOGIN_PHONE=+821000000000
# REVIEW_LOGIN_CODE=

# ─── Android apps (apps/android) ───
# SHA-256 of 익히미's own upload key (apps/android/README.md), and of Google Play's app-signing key once the app is on Play.
# ANDROID_UPLOAD_SHA256=
# ANDROID_PLAY_SHA256=
# Version of the APK put in apps/web/public/download/ikhimi.apk. Unset = the download banner and /android stay hidden.
# ANDROID_APK_VERSION=1.0.0

# ─── iOS app (apps/ios) ───
# One key from developer.apple.com → Certificates, IDs & Profiles → Keys → "+", with both "Sign in with Apple" and
# "Apple Push Notifications service (APNs)" ticked. Sign in with Apple (the App Store requires it next to Telegram),
# notifications on iPhones, and links opening in the app (/.well-known/apple-app-site-association) all need these.
# Unset = no Apple button and no iPhone notifications.
# APPLE_TEAM_ID=            # 10 characters, Membership details
# APPLE_KEY_ID=             # 10 characters, shown next to the key
# APPLE_PRIVATE_KEY=        # the .p8 file's text; "\n" may stand for the line breaks
# APPLE_BUNDLE_ID=kr.ikhimi.app

# ─── Sign in with Google (the website; not inside the apps) ───
# console.cloud.google.com → APIs & Services → OAuth consent screen (External, app name 익히미), then Credentials →
# Create credentials → OAuth client ID → Web application, with Authorized redirect URI
# https://<the site>/api/auth/google/callback (one per address the site is opened on). Unset = no Google button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
