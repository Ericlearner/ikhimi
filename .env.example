# Copy to apps/web/.env.local and workers/.env (or export in your shell). On Vercel, the same names go in
# Settings → Environment Variables. Every value here belongs to 익히미 only: never reuse another app's keys or bots.
DATABASE_URL=postgres://ikhimi:ikhimi@localhost:5432/ikhimi

# ─── Sign in with Google: the one way in on the website and in the Android apps (the iOS app uses Apple) ───
# console.cloud.google.com → a new project for 익히미 → APIs & Services → OAuth consent screen (External, app name
# 익히미, then Publish app) → Credentials → Create credentials → OAuth client ID → Web application, with Authorized
# redirect URI https://<the site>/api/auth/google/callback (one per address the site is opened on; for local
# development also http://localhost:3000/api/auth/google/callback). Unset = nobody can sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin panel (/admin). Owners: comma-separated Google emails, with full access, the only ones who manage staff.
# Assistants are added inside the panel (Staff) by the Google email they sign in with, and a role.
OWNER_EMAILS=
# Local only: `pnpm db:seed` gives its demo teacher this email, so signing in with Google as it opens the demo class
# SEED_TEACHER_EMAIL=

# Homework generation and grading: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Default model for every task, and the fallback when a task's own model is busy
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# Paid plan (DECISIONS.md AO): put your strongest model on the quality-critical tasks. Unset = GEMINI_MODEL.
# Use the exact model id from AI Studio; a wrong id makes generation fail with "AI rejected".
# GEMINI_MODEL_GENERATE=   # writing homework
# GEMINI_MODEL_PLAN=       # Create mode's plan step: reads the pages, picks counts and words (fast is best)
# GEMINI_MODEL_REVIEW=     # checking/repairing items, solve-back, listening audio match
# GEMINI_MODEL_GRADE=      # grading essays and students' own sentences
# GEMINI_MODEL_FAST=       # small chores
# GEMINI_MODEL_LAB=        # the owner's Lab: put the very strongest model here (unset = GENERATE, then REVIEW).
#                            Never falls back to a weaker model: when it's busy, the Lab says "try again".
# Pronunciation for vocabulary items ("listen and choose the word"); off = those items ask by meaning instead
# GEMINI_MODEL_TTS=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Kore
# Model reasoning: level (Gemini 3 models) | budget (Gemini 2.5) | off
GEMINI_THINKING=off
# Second pass that checks and repairs every generated item (Create mode): 1 on, 0 off
AI_REVIEW=1

# AI price list for the cost estimates, USD per million tokens [input, output]; the longest key found in the
# model name wins. Unset = built-in estimates by family (flash-lite, flash, pro).
# AI_PRICES={"gemini-3.8-flash":[0.5,3],"pro":[2,12]}
# Won per dollar, for showing AI cost in won
# USD_KRW=1400
# Local only: canned demo AI when no key is set (ignored in production)
# LLM_FAKE=1

# Methodology retrieval (§8.5): embeds packages/pedagogy content for the Plan/Verify stages.
# Uses the same GEMINI_API_KEY above. Run `pnpm pedagogy:seed` after changing pedagogy content.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# File storage. Leave S3_* empty to store uploads in Postgres (fine for Vercel / small pilots).
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=https://files.ikhimi.kr
S3_REGION=us-east-1
S3_BUCKET=ikhimi
S3_ACCESS_KEY=ikhimi
S3_SECRET_KEY=ikhimi-dev-secret

# The site's own address (links, QR codes). In production: https://<your domain>
PUBLIC_ORIGIN=http://localhost:3000

# ─── Payments (courses, student plans, teacher packages) ───
# No payment gateway is connected yet (a Korean one such as Toss Payments plugs into server/payments/providers.ts).
# Until then nothing is sold; the "test" provider tries the purchase flow.
# The test provider is always on in development; in production only with this flag (anyone could "pay" with it!).
# PAYMENT_TEST_ENABLED=1

# ─── Daily job and alerts ───
# Vercel calls /api/cron/daily every evening at 18:00 Korean time (apps/web/vercel.json): due-tomorrow reminders,
# erasing accounts deleted 30+ days ago. Set any long random string; Vercel sends it with the call so nobody else can
# run the job.
# CRON_SECRET=
# "Something broke" alerts always go to the server log (Vercel → Logs), and to the owners' iPhones when an
# OWNER_EMAILS account uses the iOS app with notifications on.

# ─── Android apps (apps/android) ───
# SHA-256 of 익히미's own upload key (apps/android/README.md), and of Google Play's app-signing key once the app is on Play.
# ANDROID_UPLOAD_SHA256=
# ANDROID_PLAY_SHA256=
# Version of the APK put in apps/web/public/download/ikhimi.apk. Unset = the download banner and /android stay hidden.
# ANDROID_APK_VERSION=1.0.0

# ─── iOS app (apps/ios) ───
# One key from developer.apple.com → Certificates, IDs & Profiles → Keys → "+", with both "Sign in with Apple" and
# "Apple Push Notifications service (APNs)" ticked. Sign in with Apple (the iOS app's only way in: Google refuses to
# sign in inside an app's web view), notifications on iPhones (the only notifications 익히미 sends), and links opening
# in the app (/.well-known/apple-app-site-association) all need these. Unset = no sign-in and no notifications there.
# APPLE_TEAM_ID=            # 10 characters, Membership details
# APPLE_KEY_ID=             # 10 characters, shown next to the key
# APPLE_PRIVATE_KEY=        # the .p8 file's text; "\n" may stand for the line breaks
# APPLE_BUNDLE_ID=kr.ikhimi.app
