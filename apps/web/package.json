{
  "name": "@ikhimi/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "predev": "node scripts/sync-brand.mjs",
    "prebuild": "node scripts/sync-brand.mjs",
    "telegram:poll": "tsx --env-file=.env.local scripts/telegram.ts poll",
    "telegram:webhook": "tsx --env-file=.env.local scripts/telegram.ts webhook",
    "vercel-build": "pnpm --filter @ikhimi/db migrate && pnpm --filter @ikhimi/pedagogy seed --optional && node scripts/sync-brand.mjs && next build",
    "telegram:support-webhook": "tsx --env-file=.env.local scripts/telegram.ts support-webhook",
    "telegram:support-poll": "tsx --env-file=.env.local scripts/telegram.ts support-poll"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "docx": "^9.8.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@napi-rs/canvas": "^1.0.9",
    "@ikhimi/ai": "workspace:^",
    "@ikhimi/db": "workspace:^",
    "@ikhimi/i18n": "workspace:^",
    "@ikhimi/pedagogy": "workspace:^",
    "@ikhimi/ui": "workspace:^",
    "@vercel/analytics": "^2.0.1",
    "fflate": "^0.8.2",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.0",
    "opencc-js": "^1.4.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "19",
    "react-dom": "19",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  }
}
